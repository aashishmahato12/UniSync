{
  "name": "UniSync — send payment receipts with Gmail",
  "nodes": [
    {
      "id": "b57470fe-9347-40b6-9151-8863b45bcdb1",
      "name": "Check Receipt Queue",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "c7bc12c8-3c49-4d0b-9b2a-8f31d9e2cab9",
      "name": "Claim Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://qozetqmklegcnjgxtgpd.supabase.co/rest/v1/rpc/claim_next_payment_receipt",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "56139b47-a384-4f40-9868-38905e677e26",
      "name": "Prepare Receipt Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Validate the claimed receipt before downloading any file or sending email.\r\n// Replace this only with the college's verified payment-receipt address.\r\nconst recipient = 'aashishmahato8000@gmail.com';\r\nconst job = $input.item.json;\r\nconst allowedPayments = new Set(['admission', 'semester-1', 'semester-2', 'semester-3', 'semester-4', 'semester-5', 'semester-6']);\r\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(recipient)) {\r\n  throw new Error('Configure the verified college receipt address before activating this workflow.');\r\n}\r\nif (!allowedPayments.has(job.payment_id) || job.status !== 'processing') {\r\n  throw new Error('Receipt job is not a claimed scheduled payment.');\r\n}\r\nif (!Number.isFinite(Number(job.amount)) || Number(job.amount) <= 0 ||\r\n    !/^\\d{4}-\\d{2}-\\d{2}$/.test(String(job.paid_on)) ||\r\n    !String(job.transaction_id || '').trim() ||\r\n    !String(job.email_body || '').trim()) {\r\n  throw new Error('Receipt job has missing payment details.');\r\n}\r\nconst receiptUrl = String(job.signed_receipt_url || '');\r\nconst expectedPrefix = 'https://qozetqmklegcnjgxtgpd.supabase.co/storage/v1/object/sign/payment-receipts/';\r\nconst expectedPath = String(job.receipt_path || '').split('/').map(encodeURIComponent).join('/');\r\nif (!receiptUrl.startsWith(expectedPrefix + expectedPath + '?') ||\r\n    !receiptUrl.includes('?token=')) {\r\n  throw new Error('Receipt URL does not match the private Supabase file path.');\r\n}\r\nif (!['application/pdf', 'image/jpeg', 'image/png'].includes(job.receipt_mime)) {\r\n  throw new Error('Receipt file type is not allowed.');\r\n}\r\nconst subject = 'Herald College payment receipt — ' + String(job.payment_title).slice(0, 120);\r\nconst details = [\r\n  '',\r\n  'Payment details',\r\n  'Fee: ' + job.payment_title,\r\n  'Amount: NPR ' + Number(job.amount).toLocaleString('en-US'),\r\n  'Paid on: ' + job.paid_on,\r\n  'Method: ' + job.payment_type,\r\n  'Transaction ID: ' + job.transaction_id,\r\n];\r\nreturn { json: {\r\n  jobId: job.id,\r\n  recipient,\r\n  subject,\r\n  message: String(job.email_body).trim() + '\\n' + details.join('\\n'),\r\n  receiptUrl,\r\n  receiptName: String(job.receipt_name || 'receipt').slice(0, 180),\r\n} };\r\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "a7c3e8d5-f759-4626-9fce-baf9fc996067",
      "name": "Download Private Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.receiptUrl }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "c629246a-5d8b-4d7b-9979-9710f0c85853",
      "name": "Name Receipt Attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $('Prepare Receipt Email').first().json;\nconst item = $input.item;\nif (!item.binary?.data) throw new Error('Receipt attachment download returned no file.');\nitem.binary.data.fileName = source.receiptName;\nreturn { json: source, binary: item.binary };\n\r\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "86a40d8e-c3e9-4e8b-a75e-b81b804b41a7",
      "name": "Send Receipt via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Prepare Receipt Email').first().json.recipient }}",
        "subject": "={{ $('Prepare Receipt Email').first().json.subject }}",
        "emailType": "text",
        "message": "={{ $('Prepare Receipt Email').first().json.message }}",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "data"
              }
            ]
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "435dce5d-1ee1-4244-a680-727442281b37",
      "name": "Check Gmail Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const id = String($input.item.json.id || '');\nif (!id) throw new Error('Gmail did not return a message ID. Check Sent mail before retrying.');\nreturn { json: { gmailMessageId: id } };\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "556ce358-1520-4fb4-9488-9ddfa59626cf",
      "name": "Mark Receipt Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -120
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ \"https://qozetqmklegcnjgxtgpd.supabase.co/rest/v1/payment_receipt_jobs?id=eq.\" + encodeURIComponent($('Claim Receipt').first().json.id) + \"&status=eq.processing\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { status: \"sent\", gmail_message_id: $json.gmailMessageId, sent_at: new Date().toISOString(), updated_at: new Date().toISOString() } }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "73b93377-d7b9-4325-8178-5c59c81585eb",
      "name": "Mark Delivery Unconfirmed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        240
      ],
      "parameters": {
        "method": "PATCH",
        "url": "={{ \"https://qozetqmklegcnjgxtgpd.supabase.co/rest/v1/payment_receipt_jobs?id=eq.\" + encodeURIComponent($('Claim Receipt').first().json.id) + \"&status=eq.processing\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { status: \"failed\", error_message: \"Delivery not confirmed. Check Gmail Sent and the n8n execution before retrying.\", updated_at: new Date().toISOString() } }}",
        "options": {
          "timeout": 15000
        }
      }
    }
  ],
